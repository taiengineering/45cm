{
  "name": "marketing-engine",
  "version": "1.0.0",
  "description": "AI Marketing Operations Engine — Reach, Engage, Convert",
  "boundary": "CTA 이전까지 책임. CTA 이후는 관재엔진 책임.",
  "capabilities": [
    "collect",
    "classify",
    "generate",
    "humanize",
    "approval",
    "publish",
    "campaign",
    "engagement",
    "analytics",
    "lead_generation",
    "brand_voice",
    "channel_operations"
  ],
  "channels": ["naver_kin", "linkedin", "facebook", "naver_blog"],
  "events_output": [
    "lead.generated",
    "cta.clicked",
    "campaign.completed",
    "publish.completed",
    "engagement.detected"
  ],
  "dependencies": {
    "required": ["redis", "openai"],
    "replaceable": ["supabase"],
    "optional": ["slack", "linkedin", "facebook"]
  },
  "excluded": [
    "internal_user_operations",
    "dau_retention",
    "task_management",
    "erp_bpm",
    "generic_workflow",
    "organization_runtime"
  ]
}