{
  "name": "marketing-engine",
  "version": "1.0.0",
  "description": "AI Marketing Operations Engine \u2014 Reach, Engage, Convert",
  "boundary": "CTA \uc774\uc804\uae4c\uc9c0 \ucc45\uc784. CTA \uc774\ud6c4\ub294 \uad00\uc7ac\uc5d4\uc9c4 \ucc45\uc784.",
  "runtime_tiers": {
    "core": ["ai","queue","publish","db","event","scheduler","cache"],
    "safety": ["tenant-isolation","policy-engine","permissions","publish-safety","token-budget","retry-policy","emergency-stop"],
    "operational": ["campaign-intelligence","channel-health","strategy-memory","channel-integration","visual","brand"],
    "simulation": ["simulation"],
    "experimental": ["simulation-world"]
  },
  "engine_modes": {
    "minimal": "core + safety (12 runtimes)",
    "operational": "core + safety + operational (20 runtimes)",
    "simulation": "operational + simulation (21 runtimes)",
    "enterprise": "all runtimes (22)",
    "development": "all + debug"
  },
  "capabilities": [
    "collect","classify","generate","humanize","approval","publish",
    "campaign","engagement","analytics","lead_generation","brand_voice",
    "channel_operations","channel_integration","simulation","policy_enforcement"
  ],
  "channels": [
    {"provider":"linkedin","status":"active","capabilities":["publish_post","publish_image","publish_comment","analytics"]},
    {"provider":"facebook","status":"placeholder","capabilities":["publish_post","publish_image","publish_comment","analytics"]},
    {"provider":"naver_blog","status":"placeholder","capabilities":["publish_post","publish_image"]},
    {"provider":"naver_kin","status":"active","capabilities":["collect"]},
    {"provider":"instagram","status":"planned"},
    {"provider":"youtube","status":"planned"},
    {"provider":"x_twitter","status":"planned"},
    {"provider":"threads","status":"planned"}
  ],
  "events_output": ["lead.generated","cta.clicked","campaign.completed","publish.completed","engagement.detected"],
  "integration_architecture": {
    "pattern": "adapter",
    "registry": "channelRegistry",
    "new_channel_steps": ["1. Adapter","2. Registry register","3. Provider config","4. UI auto-extends"]
  },
  "safety": {
    "tenant_isolation": true,
    "publish_safety": true,
    "emergency_stop": true,
    "policy_engine": true,
    "token_budget": true,
    "permissions": "5 roles (owner/strategist/operator/reviewer/viewer)"
  },
  "dependencies": {
    "required": ["redis","openai"],
    "replaceable": ["supabase"],
    "optional": ["slack","linkedin","facebook"]
  },
  "excluded": ["internal_user_operations","dau_retention","task_management","erp_bpm","generic_workflow","organization_runtime"]
}